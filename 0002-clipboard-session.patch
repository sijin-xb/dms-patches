+// runSession drives the private Wayland session that both records selections
+// and owns them when the user pastes from history.
+//
+// The shared wlcontext dispatcher never delivers ext_data_control selection
+// events to this manager: the device is created without error but no event
+// arrives on it, while a connection of our own does receive them. Watching and
+// owning on that one connection also lets IsOwner tell a compositor echo of our
+// own set_selection apart from a real copy, so restores are not re-recorded.
+func (m *Manager) runSession(ctx context.Context) {
+	defer m.watcherWg.Done()
+
+	cs, err := clipboardstore.OpenSession()
+	if err != nil {
+		log.Errorf("Clipboard session unavailable: %v", err)
+		return
+	}
+	defer cs.Close()
+
+	cs.SetSelectionHandler(func(data []byte, mimeType string, _ []string) {
+		if !m.alive {
+			return
+		}
+		cfg := m.getConfig()
+		if cfg.Disabled || m.db == nil {
+			return
+		}
+		if len(data) == 0 || int64(len(data)) > cfg.MaxEntrySize {
+			return
+		}
+		if len(bytes.TrimSpace(data)) == 0 {
+			return
+		}
+
+		m.storeClipboardEntry(data, mimeType, nil, "")
+		m.updateState()
+		m.notifySubscribers()
+	})
+
+	m.ownerLock.Lock()
+	m.session = cs
+	m.ownerLock.Unlock()
+
+	if err := cs.Run(ctx); err != nil && ctx.Err() == nil {
+		log.Errorf("Clipboard session stopped: %v", err)
+	}
+}
