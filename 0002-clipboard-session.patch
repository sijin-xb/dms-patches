+package clipboard
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/AvengeMedia/dankgo/wayland/ext_data_control"
+	"github.com/AvengeMedia/dankgo/wlclipboard"
+)
+
+// Session owns one long-lived Wayland connection for everything clipboard
+// related: it observes selection changes and can take the selection itself.
+//
+// Keeping both roles on the same connection is what makes ownership tracking
+// reliable. Two separate connections cannot tell "the compositor echoed our
+// own set_selection" from "some other app copied", so a watcher on its own
+// connection records every restore as a fresh copy and dedupes away the row
+// the panel is about to paste from.
+type Session struct {
+	s      *session
+	device *ext_data_control.ExtDataControlDeviceV1
+
+	offerMutex sync.Mutex
+	offers     map[*ext_data_control.ExtDataControlOfferV1][]string
+
+	sourceMutex sync.Mutex
+	source      *ext_data_control.ExtDataControlSourceV1
+	owning      bool
+
+	writeTimeout time.Duration
+}
+
+// OpenSession connects and binds everything needed to both watch and own the
+// selection. The returned session must be closed by the caller.
+func OpenSession() (*Session, error) {
+	s, err := connectSession()
+	if err != nil {
+		return nil, err
+	}
+
+	mgr, err := s.requireDataControl()
+	if err != nil {
+		s.Close()
+		return nil, err
+	}
+
+	device, err := mgr.GetDataDevice(s.seat)
+	if err != nil {
+		s.Close()
+		return nil, fmt.Errorf("get data device: %w", err)
+	}
+
+	cs := &Session{
+		s:            s,
+		device:       device,
+		offers:       make(map[*ext_data_control.ExtDataControlOfferV1][]string),
+		writeTimeout: 30 * time.Second,
+	}
+
+	device.SetDataOfferHandler(func(e ext_data_control.ExtDataControlDeviceV1DataOfferEvent) {
+		if e.Id == nil {
+			return
+		}
+		cs.offerMutex.Lock()
+		cs.offers[e.Id] = nil
+		cs.offerMutex.Unlock()
+
+		e.Id.SetOfferHandler(func(me ext_data_control.ExtDataControlOfferV1OfferEvent) {
+			cs.offerMutex.Lock()
+			cs.offers[e.Id] = append(cs.offers[e.Id], me.MimeType)
+			cs.offerMutex.Unlock()
+		})
+	})
+
+	s.display.Roundtrip()
+	s.display.Roundtrip()
+
+	return cs, nil
+}
+
+// SetSelectionHandler installs the callback invoked for every selection change
+// the compositor reports. It is not called for selections this session owns.
+func (cs *Session) SetSelectionHandler(fn func(data []byte, mimeType string, mimes []string)) {
+	cs.device.SetSelectionHandler(func(e ext_data_control.ExtDataControlDeviceV1SelectionEvent) {
+		if cs.IsOwner() {
+			return
+		}
+		if e.Id == nil {
+			return
+		}
+
+		cs.offerMutex.Lock()
+		mimes := append([]string(nil), cs.offers[e.Id]...)
+		cs.offerMutex.Unlock()
+
+		mime := selectPreferredMimeType(mimes)
+		if mime == "" {
+			return
+		}
+
+		r, w, err := os.Pipe()
+		if err != nil {
+			return
+		}
+		if err := e.Id.Receive(mime, int(w.Fd())); err != nil {
+			w.Close()
+			r.Close()
+			return
+		}
+		w.Close()
+
+		go func() {
+			defer r.Close()
+			data, err := io.ReadAll(r)
+			if err != nil || len(data) == 0 {
+				return
+			}
+			fn(data, mime, mimes)
+		}()
+	})
+}
+
+// Run dispatches Wayland events until ctx is cancelled.
+func (cs *Session) Run(ctx context.Context) error {
+	for {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+			if err := cs.s.ctx.SetReadDeadline(time.Now().Add(100 * time.Millisecond)); err != nil {
+				return fmt.Errorf("set read deadline: %w", err)
+			}
+			if err := cs.s.ctx.Dispatch(); err != nil {
+				if isTimeoutError(err) {
+					continue
+				}
+				return fmt.Errorf("dispatch: %w", err)
+			}
+		}
+	}
+}
+
+// Take makes this session the selection owner and serves the given offers.
+// A previous source, if any, is released first.
+func (cs *Session) Take(offers []wlclipboard.Offer) error {
+	if len(offers) == 0 {
+		return fmt.Errorf("no offers to serve")
+	}
+
+	mgr, err := cs.s.requireDataControl()
+	if err != nil {
+		return err
+	}
+
+	source, err := mgr.CreateDataSource()
+	if err != nil {
+		return fmt.Errorf("create data source: %w", err)
+	}
+
+	offerData := make(map[string][]byte, len(offers))
+	for _, offer := range offers {
+		if err := source.Offer(offer.MimeType); err != nil {
+			source.Destroy()
+			return fmt.Errorf("offer %s: %w", offer.MimeType, err)
+		}
+		offerData[offer.MimeType] = offer.Data
+	}
+
+	timeout := cs.writeTimeout
+	source.SetSendHandler(func(e ext_data_control.ExtDataControlSourceV1SendEvent) {
+		data, ok := offerData[e.MimeType]
+		if !ok {
+			syscall.Close(e.Fd)
+			return
+		}
+		go writeSelection(e.Fd, data, timeout)
+	})
+
+	source.SetCancelledHandler(func(e ext_data_control.ExtDataControlSourceV1CancelledEvent) {
+		cs.sourceMutex.Lock()
+		if cs.source == source {
+			cs.source = nil
+			cs.owning = false
+		}
+		cs.sourceMutex.Unlock()
+	})
+
+	cs.sourceMutex.Lock()
+	prev := cs.source
+	cs.source = source
+	cs.owning = true
+	cs.sourceMutex.Unlock()
+
+	if err := cs.device.SetSelection(source); err != nil {
+		cs.sourceMutex.Lock()
+		if cs.source == source {
+			cs.source = nil
+			cs.owning = false
+		}
+		cs.sourceMutex.Unlock()
+		source.Destroy()
+		return fmt.Errorf("set selection: %w", err)
+	}
+
+	// No roundtrip here: Run() keeps a short read deadline on this connection,
+	// so a blocking roundtrip would return i/o timeout instead of waiting for
+	// the compositor. The compositor processes requests in order, so the new
+	// set_selection lands before the previous source is destroyed below.
+	if prev != nil {
+		go func() {
+			time.Sleep(200 * time.Millisecond)
+			prev.Destroy()
+		}()
+	}
+
+	return nil
+}
+
+// IsOwner reports whether this session currently owns the selection.
+func (cs *Session) IsOwner() bool {
+	cs.sourceMutex.Lock()
+	defer cs.sourceMutex.Unlock()
+	return cs.owning
+}
+
+// writeSelection answers a paste request. It runs in its own goroutine so a
+// receiver that never drains the pipe cannot stall the event loop.
+func writeSelection(fd int, data []byte, timeout time.Duration) {
+	_ = syscall.SetNonblock(fd, false)
+	file := os.NewFile(uintptr(fd), "clipboard-pipe")
+	defer file.Close()
+
+	_ = file.SetWriteDeadline(time.Now().Add(timeout))
+	_, _ = file.Write(data)
+}
+
+// Close releases the selection and the connection.
+func (cs *Session) Close() {
+	cs.sourceMutex.Lock()
+	source := cs.source
+	cs.source = nil
+	cs.owning = false
+	cs.sourceMutex.Unlock()
+
+	if source != nil {
+		source.Destroy()
+	}
+	if cs.device != nil {
+		cs.device.Destroy()
+	}
+	cs.s.Close()
+}
+
