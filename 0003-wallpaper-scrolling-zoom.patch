@@ -104,12 +104,74 @@ Variants {
 
             property string scrollMode: SettingsData.wallpaperFillMode
             property bool scrollingEnabled: scrollMode === "Scrolling"
+            property real wallpaperZoom: SettingsData.wallpaperZoom
