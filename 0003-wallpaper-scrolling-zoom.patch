+            property real windowParallax: SettingsData.wallpaperWindowParallax
+            onWindowParallaxChanged: updateWindowParallax()
             property int currentWorkspaceIndex: 0
             property int totalWorkspaces: 1
-            // Also requires the image to overflow on the compositor's scroll
-            // axis — niri scrolls Y, Hyprland scrolls X — otherwise the
-            // currentWallpaper Fill fallback handles it.
-            property bool effectiveScrolling: scrollingEnabled && totalWorkspaces > 1 && (!imageMetrics.ready || (CompositorService.isNiri && imageMetrics.nativeWidth / imageMetrics.nativeHeight < root.textureWidth / root.textureHeight - 0.01) || (CompositorService.isHyprland && imageMetrics.nativeWidth / imageMetrics.nativeHeight > root.textureWidth / root.textureHeight + 0.01))
+            // Overflow is judged on the zoomed canvas, not the raw aspect:
+            // zoom > 1 widens the travel; at zoom 1.0 this matches upstream.
+            readonly property bool canvasOverflows: !imageMetrics.ready || imageMetrics.canvasHeight > root.textureHeight * 1.01 || imageMetrics.canvasWidth > root.textureWidth * 1.01
+            property bool effectiveScrolling: scrollingEnabled && (totalWorkspaces > 1 || (windowParallax > 0 && CompositorService.isNiri)) && canvasOverflows
+
+            // Window-driven parallax: the focused window's column/row in the
+            // scrolling layout maps to the offset — leftmost column is 0, each
+            // column to the right shifts further. Per-workspace by construction.
+            property real windowParallaxX: 0.0
+            property real windowParallaxY: 0.0
+
+            function updateWindowParallax() {
+                if (!effectiveScrolling || windowParallax <= 0 || !CompositorService.isNiri) {
+                    if (windowParallaxX !== 0 || windowParallaxY !== 0) {
+                        windowParallaxX = 0;
+                        windowParallaxY = 0;
+                        restartScrollAnim();
+                    }
+                    return;
+                }
+                const wid = NiriService.lastFocusedWindowId;
+                const wsWindows = NiriService.windows.filter(w => {
+                    const ws = NiriService.workspaces[w.workspace_id];
+                    return ws && ws.output === modelData.name && ws.is_active;
+                });
+                const focused = wsWindows.find(w => w.id === wid);
+                let tx = 0, ty = 0;
+                if (focused) {
+                    const cols = wsWindows.map(w => (w.layout?.pos_in_scrolling_layout?.[0]) ?? 1);
+                    const rows = wsWindows.map(w => (w.layout?.pos_in_scrolling_layout?.[1]) ?? 1);
+                    const minCol = Math.min(...cols), maxCol = Math.max(...cols);
+                    const minRow = Math.min(...rows), maxRow = Math.max(...rows);
+                    const col = focused.layout?.pos_in_scrolling_layout?.[0] ?? minCol;
+                    const row = focused.layout?.pos_in_scrolling_layout?.[1] ?? minRow;
+                    if (maxCol > minCol)
+                        tx = ((col - minCol) / (maxCol - minCol)) * 100.0 * windowParallax;
+                    if (maxRow > minRow)
+                        ty = ((row - minRow) / (maxRow - minRow)) * 100.0 * windowParallax;
+                }
+                if (Math.abs(tx - windowParallaxX) < 0.01 && Math.abs(ty - windowParallaxY) < 0.01)
+                    return;
+                windowParallaxX = tx;
+                windowParallaxY = ty;
+                restartScrollAnim();
+            }
+
+            function restartScrollAnim() {
+                if (effectiveScrolling)
+                    scrollAnim.startAnimation(scrollAnim.baseTargetX + windowParallaxX, scrollAnim.baseTargetY + windowParallaxY);
+            }
+
+            Connections {
+                target: CompositorService.isNiri ? NiriService : null
+                enabled: CompositorService.isNiri && root.effectiveScrolling && root.windowParallax > 0
+
+                function onLastFocusedWindowIdChanged() {
+                    root.updateWindowParallax();
+                }
+                function onWindowsChanged() {
+                    root.updateWindowParallax();
+                }
+            }
 
