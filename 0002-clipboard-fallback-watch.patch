 	"errors"
 	"fmt"
@@ -109,9 +110,50 @@ func NewManager(wlCtx wlcontext.WaylandContext, config Config) (*Manager, error)
 		m.setupDataDeviceSync()
 	}
 
+	if !config.Disabled {
+		watchCtx, watchCancel := context.WithCancel(context.Background())
+		m.watcherCancel = watchCancel
+		m.watcherWg.Add(1)
+		go m.watchFallback(watchCtx)
+	}
+
 	return m, nil
 }
 
+// watchFallback records selections over a private wayland connection.
+//
+// The shared wlcontext dispatcher never delivers ext_data_control selection
+// events to this manager: the device is created without error but no event
+// arrives on it, while a standalone connection in the same process does
+// receive them. Writes go through m.db so this does not fight the daemon for
+// the bolt file lock the way `dms clipboard watch -s` would.
+func (m *Manager) watchFallback(ctx context.Context) {
+	defer m.watcherWg.Done()
+
+	err := clipboardstore.WatchAll(ctx, func(data []byte, mimeType string, _ []string) {
+		if !m.alive {
+			return
+		}
+		cfg := m.getConfig()
+		if cfg.Disabled || m.db == nil {
+			return
+		}
+		if len(data) == 0 || int64(len(data)) > cfg.MaxEntrySize {
+			return
+		}
+		if len(bytes.TrimSpace(data)) == 0 {
+			return
+		}
+
+		m.storeClipboardEntry(data, mimeType, nil, "")
+		m.updateState()
+		m.notifySubscribers()
+	})
+	if err != nil {
+		log.Errorf("Clipboard fallback watcher stopped: %v", err)
+	}
+}
